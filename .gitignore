.DS_Store
node_modules/
*.log

# Raw asset-pack downloads: hundreds of MB of vector sources and full
# animation sets. Only the selected, optimised sprites belong in git.
game/assets/incoming/*.zip
game/assets/incoming/extracted/
# Music as downloaded. tools/convert-music.py writes the trimmed, levelled copies
# the game plays into game/assets/music/, and those are what belong in git.
game/assets/incoming/music/

# What tools/build-itch.py makes: the folder and zip for itch.io. Rebuilt on demand.
dist/

# Blender, used by the character-render test to turn 3D models into sprites (900 MB; from blender.org).
tools/_blender/
# Title pictures being tried, as they came from the tool. The one chosen is added on purpose.
game/assets/incoming/title-candidate-*
tools/3d/_work/
